{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "./compiled",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-native"
  },
"include": [
    "../scripts/planner_g0_3_cache_tests.ts",
    "../scripts/homeplus_core_frontend_tests.ts",
    "../scripts/planner_v1_navigation_tests.ts",
    "../scripts/planner_v1_mutation_tests.ts",
    "../scripts/planner_v1_error_tests.ts",
    "../scripts/planner_v1_capabilities_flags_tests.ts",
    "../scripts/planner_v1_shell_state_tests.ts",
    "../scripts/planner_v1_sheet_state_tests.ts",
    "../front/mi-front-limpio/services/core/*.ts",
    "../front/mi-front-limpio/services/planner/*.ts",
    "../front/mi-front-limpio/navigation/plannerNavigationContract.ts"
  ],
  "exclude": ["node_modules"]
}
