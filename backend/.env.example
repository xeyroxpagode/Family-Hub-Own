# Variables de entorno para HomePlus Backend
# Copiar este archivo a .env y completar con valores reales

# Puerto del servidor (opcional, default: 3000)
PORT=3000

# Ambiente de ejecución (development/production)
NODE_ENV=development

# CORS - Origen(es) permitidos en producción (separados por coma)
# Ejemplo: https://mi-app.vercel.app,https://mi-app.firebaseapp.com
CORS_ORIGIN=

# Supabase - URL del proyecto
SUPABASE_URL=https://your-project.supabase.co

# Supabase - Anon/Public Key (segura para cliente)
SUPABASE_ANON_KEY=your-anon-key

# Supabase - Service Role Key (PRIVADA - usar solo en backend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HomeCloud application acceptance ceiling. Deployment-configured; keep it
# aligned with the Supabase global Storage ceiling and any bucket policy.
HOMECLOUD_MAX_UPLOAD_BYTES=5368709120

# Office Viewer V1 (ONLYOFFICE, OFFICE-1). JWT secret obligatorio en runtime.
# URL pública HTTPS del DocServer (la que abren el móvil y el túnel temporal).
# Solo alimenta `documentServerUrl` (api.js) y NUNCA la descarga del documento.
ONLYOFFICE_PUBLIC_URL=
# Base del BACKEND vista desde la red del contenedor DocServer (OBLIGATORIA
# en runtime con túnel). Es la que forma `document.url` (`GET
# /api/homecloud/office/:sessionId/document`). En dev con backend en el host:
# http://host.docker.internal:3000 (ajustar el puerto al de PORT).
# Sin esta variable la creación de sesión falla con office_viewer_unavailable
# a propósito: el fallback anterior apuntaba al DocServer y el documento
# jamás llegaba (OFFICE-2, ECONNREFUSED).
ONLYOFFICE_INTERNAL_API_URL=
# Secreto HS256 compartido entre backend y DocServer. OBLIGATORIO en runtime.
# Generar local y no commitear: openssl rand -base64 48
ONLYOFFICE_JWT_SECRET=
# Cap de bytes por documento para vista previa (default 104857600 = 100 MB).
ONLYOFFICE_VIEWER_MAX_BYTES=104857600
